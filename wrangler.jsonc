{
  "name": "propwash-fpv",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only /api/* runs the Worker. Everything else is a static file, which is free and not counted as a request.
    "run_worker_first": ["/api/*"]
  },
  // Live race rooms: one Durable Object per room. SQLite-backed is the only kind the free plan allows.
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "RaceRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RaceRoom"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "propwash-fpv",
      "migrations_dir": "migrations"
    }
  ]
}
