{
  "name": "propwash-fpv",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "cf:dev": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261101.1",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
